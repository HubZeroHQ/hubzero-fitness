{
  "name": "hubzero-fitness",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "admin": "node server/admin.js",
    "test": "pnpm test:server && pnpm test:unit",
    "format": "oxfmt",
    "test:server": "node --test server/app.test.js server/edge.test.js server/coach.test.js server/audit.test.js",
    "test:unit": "vitest run",
    "test:e2e": "vite build && playwright test",
    "test:all": "pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.1"
  }
}
